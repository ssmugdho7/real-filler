{
  "manifest_version": 3,
  "name": "Real Filler",
  "version": "1.0",
  "description": "Automatically fills Google Forms based on your previous submissions.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://docs.google.com/forms/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Real Filler"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/forms/*"],
      "js": ["content/content.js"],
      "run_at": "document_end"
    }
  ]
}
